    "@openai/codex-sdk": "0.153.4",
    "ajv": "8.20.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.3",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.41.0",
    "nodemailer": "10.0.3",
    "pg": "8.23.0",
    "playwright": "1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
