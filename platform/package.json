{
  "name": "tanviko-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "web": "vite",
    "start": "node src/server.mjs",
