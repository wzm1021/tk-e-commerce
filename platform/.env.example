# Real values are supplied by deployment; never commit credentials.
HOST=127.0.0.1
PORT=9080
DATABASE_URL=
DATA_ROOT=/srv/tidelab/data
MASTER_KEY_FILE=/etc/tidelab/master.key
WORKER_TOKEN_FILE=/etc/tidelab/worker.token
PUBLIC_ORIGIN=http://127.0.0.1:4310
COOKIE_SECURE=false
MAX_RUNNING_JOBS=1
DB_POOL_SIZE=5
LOG_LEVEL=warn
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_PORT=9443
