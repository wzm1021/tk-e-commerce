# A dedicated HTTP ingress for the user-authorized IP-based closed beta.
# Replace __PUBLIC_IP__ with the application's public IPv4 address.
user www-data;
worker_processes 1;
pid /run/tidelab-public/nginx.pid;
error_log /var/log/tidelab-public/error.log warn;
events { worker_connections 1024; }
http {
    server_tokens off;
    access_log off;
    client_body_temp_path /var/lib/nginx/tidelab-body;
    proxy_temp_path /var/lib/nginx/tidelab-proxy;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    server {
        listen 0.0.0.0:4310;
        server_name __PUBLIC_IP__;

        # Public admin access is opt-in via PUBLIC_ADMIN_ENABLED in the application.
        # Internal worker endpoints must never be exposed by this ingress.
        location ~ ^/internal(/|\.|$) { return 404; }

        location / {
            proxy_pass http://127.0.0.1:9080;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Tidelab-Public-Ingress 1;
            proxy_connect_timeout 5s;
            proxy_read_timeout 720s;
            proxy_send_timeout 60s;
            proxy_buffering off;
            proxy_request_buffering on;

            # 5 MiB files expand to about 6.7 MiB in JSON/base64.
            # Inherit the same proxy headers/timeouts; other routes stay at 2 MiB.
            location ~ ^/api/(ai-tests/[0-9a-fA-F-]+/image|feedback/files)$ {
                client_max_body_size 8m;
                proxy_pass http://127.0.0.1:9080;
            }
        }
    }
}
