# 推荐将 URL、Key、服务 ID 分开配置，避免密钥进入源码。
CLAWEC_MCP_URL=https://www.clawec.com/api/mcp
CLAWEC_MCP_KEY=replace-me
CLAWEC_MCP_ID=replace-me

# 可选，默认 30000 毫秒。
CLAWEC_MCP_TIMEOUT_MS=30000

# FastMoss 第二数据源
FASTMOSS_MCP_URL=https://mcp.fastmoss.com/mcp
FASTMOSS_API_KEY=replace-me
FASTMOSS_MCP_TIMEOUT_MS=30000
